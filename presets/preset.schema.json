{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deck-library:preset:v1",
  "title": "Deck Library portable preset v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "game": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "update": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "adapter": {
      "type": "object",
      "properties": {
        "id": {
          "enum": [
            "instructions",
            "pcsx2",
            "azahar",
            "mgba",
            "ppsspp",
            "project2099",
            "eden",
            "wiicompiled",
            "dolphin",
            "duckstation",
            "prism",
            "narutorise"
          ]
        },
        "versions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "versions"
      ],
      "additionalProperties": false
    },
    "hardware": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "steam-deck-lcd",
          "steam-deck-oled",
          "linux-pc"
        ]
      }
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "tested": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "proposal",
            "boot-tested",
            "user-confirmed"
          ]
        },
        "date": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "settings": {
      "type": "object",
      "minProperties": 0
    },
    "notes": {
      "type": "string",
      "maxLength": 4000
    },
    "sources": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "pattern": "^https://"
      }
    },
    "layout": {
      "type": "object",
      "properties": {
        "template": {
          "enum": [
            "keyboard-mouse",
            "gamepad"
          ]
        },
        "bindings": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "template"
      ],
      "additionalProperties": false
    },
    "instructions": {
      "type": "string",
      "maxLength": 12000
    },
    "runtime": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "native",
            "proton",
            "steam"
          ]
        },
        "version": {
          "type": "string",
          "maxLength": 100
        },
        "launch_options": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
