COMMUNITY_HOST=presets.jokerlan.xyz
TRAEFIK_NETWORK=traefik-net
TRAEFIK_RESOLVER=mytlschallenge
GITHUB_CLIENT_ID=
OIDC_ISSUER=https://auth.jokerlan.xyz/realms/master
OIDC_CLIENT_ID=deck-library
COMMUNITY_REVIEW_REQUIRED=false
# Optional comma-separated CIDRs for the private reverse-proxy network.
# Leave empty for direct connections; never trust public client networks.
COMMUNITY_TRUST_PROXY_CIDRS=
# Cuentas (nombres de usuario separados por comas) que pueden leer las solicitudes de juegos. Vacío: nadie.
COMMUNITY_ADMINS=
# Aviso opcional (HTTPS) al llegar una solicitud: webhook de Discord o tema de ntfy. Solo lleva el juego y la plataforma.
COMMUNITY_NOTIFY_URL=
